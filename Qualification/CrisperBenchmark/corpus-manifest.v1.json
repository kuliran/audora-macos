{
  "schemaVersion": 1,
  "corpusId": "audora-english-verbatim-v1",
  "qualificationProfileId": "crisperwhisper-2-small-transformers-mps-v1",
  "audioFormat": {
    "container": "wav",
    "encoding": "linear-pcm-signed-16-bit-little-endian",
    "sampleRateHz": 16000,
    "channels": 1
  },
  "thresholds": {
    "quality": {
      "maximumWordErrorRate": 0.2,
      "minimumReferenceWordCoverage": 0.8,
      "minimumVerbatimEventRecall": 0.85,
      "minimumBeginningAnchorCoverage": 1.0,
      "minimumTailAnchorCoverage": 1.0,
      "minimumWordCountRatio": 0.8,
      "maximumWordCountRatio": 1.2,
      "maximumExcessRepeatedNgramRun": 1
    },
    "timing": {
      "minimumTimedWordRatio": 0.98,
      "maximumZeroDurationWordRatio": 0.0,
      "maximumTailLagMs": 1500,
      "requireMonotonicWordTimes": true,
      "requireWordsWithinAudio": true
    },
    "runtime": {
      "maximumColdRealTimeFactor": 1.0,
      "maximumWarmRealTimeFactor": 0.75,
      "maximumPeakResidentBytes": 6442450944,
      "maximumPeakMpsDriverAllocatedBytes": 4294967296,
      "maximumThermalState": "serious",
      "thermalRecoveryTarget": "fair",
      "maximumThermalRecoverySeconds": 300
    },
    "cancellation": {
      "cancelAfterSeconds": 3,
      "maximumTerminationSeconds": 5,
      "mustExitWithoutForcedKill": true
    },
    "cachedOffline": {
      "mustSucceed": true,
      "mustProveNetworkDenied": true
    }
  },
  "fixtures": [
    {
      "id": "short",
      "audioPath": "audio/short.wav",
      "referencePath": "reference/short.json",
