{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audora Codex CLI qualification response",
  "type": "object",
  "properties": {
    "messageBlocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "markdown"
          },
          "markdown": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": ["kind", "markdown"],
        "additionalProperties": false
      }
    }
  },
  "required": ["messageBlocks"],
  "additionalProperties": false
}
