{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/InvocationAdmissionLedger.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/InvocationAdmissionEntry"
            },
            "maxItems": 4096
        }
    },
    "required": [
        "schemaVersion",
        "entries"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "InvocationAdmissionEntry": {
            "type": "object",
            "properties": {
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "lastAdmittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                }
            },
            "required": [
                "libraryId",
                "lastAdmittedAt"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
    }
}