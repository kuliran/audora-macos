{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/RecordingStagingIdentityManifest.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "recordingId": {
            "$ref": "#/$defs/RecordingId"
        },
        "sessionId": {
            "$ref": "#/$defs/SessionId"
        },
        "libraryId": {
            "$ref": "#/$defs/LibraryId"
        },
        "startedAt": {
            "$ref": "#/$defs/UTCInstant"
        },
        "canonicalFormat": {
            "$ref": "#/$defs/CanonicalAudioFormat"
        },
        "maximumFrames": {
            "type": "number",
            "const": 43200000
        },
        "recordStreamFormat": {
            "type": "string",
            "const": "audora-record-stream-v1"
        }
    },
    "required": [
        "schemaVersion",
        "recordingId",
        "sessionId",
        "libraryId",
        "startedAt",
        "canonicalFormat",
        "maximumFrames",
        "recordStreamFormat"
    ],
    "description": "Immutable identity root for exact recovery/discard authorization.",
    "$defs": {
        "RecordingId": {
            "type": "string",
            "pattern": "^rec-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "CanonicalAudioFormat": {
            "type": "object",
            "properties": {
                "sampleRateHz": {
                    "type": "number",
                    "const": 16000
                },
                "channelCount": {
                    "type": "number",
                    "const": 1
                },
                "encoding": {
                    "type": "string",
                    "const": "pcmS16LE"
                }
            },
            "required": [
                "sampleRateHz",
                "channelCount",
                "encoding"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    }
}