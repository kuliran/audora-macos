{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/CoachMemoryEnvelope.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "memoryId": {
            "$ref": "#/$defs/CoachMemoryId"
        },
        "chatId": {
            "$ref": "#/$defs/ChatId"
        },
        "generalNotes": {
            "type": "string",
            "maxLength": 32768
        },
        "sessionSummaries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/PersistedCoachMemorySessionSummary"
            }
        }
    },
    "required": [
        "schemaVersion",
        "memoryId",
        "chatId",
        "generalNotes",
        "sessionSummaries"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "CoachMemoryId": {
            "type": "string",
            "pattern": "^mem-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatId": {
            "type": "string",
            "pattern": "^cht-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PersistedCoachMemorySessionSummary": {
            "type": "object",
            "properties": {
                "sessionAttachmentId": {
                    "$ref": "#/$defs/ChatSessionAttachmentId"
                },
                "notes": {
                    "type": "string",
                    "maxLength": 32768
                }
            },
            "required": [
                "sessionAttachmentId",
                "notes"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatSessionAttachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z_-]+$"
        }
    }
}