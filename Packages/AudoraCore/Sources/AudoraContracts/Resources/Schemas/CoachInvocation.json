{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/CoachInvocation.json",
    "anyOf": [
        {
            "$ref": "#/$defs/CoachInvocationV1"
        },
        {
            "$ref": "#/$defs/CoachInvocationV2"
        },
        {
            "$ref": "#/$defs/CoachInvocationV3"
        },
        {
            "$ref": "#/$defs/CoachInvocationV4"
        },
        {
            "$ref": "#/$defs/CoachInvocationTranscriptReadFailureV4"
        }
    ],
    "$defs": {
        "CoachInvocationV1": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "attemptId",
                "providerIdempotencyValue",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV2": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "attemptId",
                "providerIdempotencyValue",
                "schemaVersion",
                "profileStatementGeneration"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV3": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 3
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "terminalFailure": {
                    "$ref": "#/$defs/CoachInvocationTerminalFailureV3"
                },
                "attempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachProviderAttempt"
                    },
                    "minItems": 1,
                    "maxItems": 4
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion",
                "profileStatementGeneration",
                "attempts"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV4": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 4
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "attempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachProviderAttempt"
                    },
                    "minItems": 1,
                    "maxItems": 4
                },
                "terminalFailure": {
                    "$ref": "#/$defs/CoachInvocationTerminalFailureV4"
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion",
                "profileStatementGeneration",
                "attempts"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationTranscriptReadFailureV4": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 4
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "attempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachProviderAttempt"
                    },
                    "minItems": 1,
                    "maxItems": 4
                },
                "terminalFailure": {
                    "type": "string",
                    "const": "coachTranscriptReadFailed"
                },
                "transcriptReadFailure": {
                    "$ref": "#/$defs/CoachTranscriptReadFailureSummary"
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion",
                "profileStatementGeneration",
                "attempts",
                "terminalFailure",
                "transcriptReadFailure"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationId": {
            "type": "string",
            "pattern": "^inv-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatId": {
            "type": "string",
            "pattern": "^cht-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PendingUserTurnId": {
            "type": "string",
            "pattern": "^ptu-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "CoachProviderAttemptId": {
            "type": "string",
            "pattern": "^atm-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ProviderIdempotencyValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._-]+$"
        },
        "ProfileRevisionId": {
            "type": "string",
            "pattern": "^prf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "CoachInvocationTerminalFailureV3": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                },
                {
                    "type": "string",
                    "const": "coachProviderError"
                },
                {
                    "type": "string",
                    "const": "coachResponseInvalid"
                }
            ]
        },
        "CoachProviderAttempt": {
            "type": "object",
            "properties": {
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                },
                "kind": {
                    "$ref": "#/$defs/CoachProviderAttemptKind"
                },
                "userMessageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "coachMessageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "freshDraftId": {
                    "$ref": "#/$defs/ChatDraftId"
                }
            },
            "required": [
                "attemptId",
                "ordinal",
                "kind",
                "userMessageId",
                "coachMessageId",
                "freshDraftId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationTerminalFailureV4": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                },
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                },
                {
                    "type": "string",
                    "const": "coachProviderError"
                },
                {
                    "type": "string",
                    "const": "coachResponseInvalid"
                }
            ]
        },
        "CoachTranscriptReadFailureSummary": {
            "anyOf": [
                {
                    "$ref": "#/$defs/CompleteCoachTranscriptReadFailureSummary"
                },
                {
                    "$ref": "#/$defs/TruncatedCoachTranscriptReadFailureSummary"
                }
            ]
        },
        "CoachProviderAttemptKind": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "standard"
                },
                {
                    "type": "string",
                    "const": "shorterRepair"
                }
            ]
        },
        "ChatMessageId": {
            "type": "string",
            "pattern": "^msg-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "CompleteCoachTranscriptReadFailureSummary": {
            "type": "object",
            "properties": {
                "sessions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachTranscriptReadFailureSession"
                    },
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true
                },
                "additionalSessionCount": {
                    "type": "number",
                    "const": 0
                }
            },
            "required": [
                "sessions",
                "additionalSessionCount"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "TruncatedCoachTranscriptReadFailureSummary": {
            "type": "object",
            "properties": {
                "sessions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachTranscriptReadFailureSession"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true
                },
                "additionalSessionCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 125
                }
            },
            "required": [
                "sessions",
                "additionalSessionCount"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachTranscriptReadFailureSession": {
            "type": "object",
            "properties": {
                "sessionAttachmentId": {
                    "$ref": "#/$defs/ChatSessionAttachmentId"
                },
                "displayLabel": {
                    "$ref": "#/$defs/CoachTranscriptReadFailureDisplayLabel"
                }
            },
            "required": [
                "sessionAttachmentId",
                "displayLabel"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatSessionAttachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z_-]+$"
        },
        "CoachTranscriptReadFailureDisplayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        }
    }
}