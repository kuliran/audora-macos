{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/CoachInvocation.json",
    "anyOf": [
        {
            "$ref": "#/$defs/CoachInvocationV1"
        },
        {
            "$ref": "#/$defs/CoachInvocationV2"
        },
        {
            "$ref": "#/$defs/CoachInvocationV3"
        }
    ],
    "$defs": {
        "CoachInvocationV1": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "attemptId",
                "providerIdempotencyValue",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV2": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "attemptId",
                "providerIdempotencyValue",
                "schemaVersion",
                "profileStatementGeneration"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV3": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 3
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "attempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachProviderAttempt"
                    },
                    "minItems": 1,
                    "maxItems": 4
                }
            },
            "required": [
                "invocationId",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion",
                "profileStatementGeneration",
                "attempts"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationId": {
            "type": "string",
            "pattern": "^inv-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatId": {
            "type": "string",
            "pattern": "^cht-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PendingUserTurnId": {
            "type": "string",
            "pattern": "^ptu-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "CoachProviderAttemptId": {
            "type": "string",
            "pattern": "^atm-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ProviderIdempotencyValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._-]+$"
        },
        "ProfileRevisionId": {
            "type": "string",
            "pattern": "^prf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "CoachProviderAttempt": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                },
                "kind": {
                    "$ref": "#/$defs/CoachProviderAttemptKind"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "transcriptHandles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachProviderTranscriptHandle"
                    },
                    "maxItems": 128
                },
                "userMessageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "coachMessageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "freshDraftId": {
                    "$ref": "#/$defs/ChatDraftId"
                }
            },
            "required": [
                "schemaVersion",
                "attemptId",
                "ordinal",
                "kind",
                "providerIdempotencyValue",
                "transcriptHandles",
                "userMessageId",
                "coachMessageId",
                "freshDraftId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachProviderAttemptKind": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "standard"
                },
                {
                    "type": "string",
                    "const": "shorterRepair"
                }
            ]
        },
        "CoachProviderTranscriptHandle": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "ChatMessageId": {
            "type": "string",
            "pattern": "^msg-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        }
    }
}