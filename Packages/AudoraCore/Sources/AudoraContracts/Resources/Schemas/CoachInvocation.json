{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/CoachInvocation.json",
    "anyOf": [
        {
            "$ref": "#/$defs/CoachInvocationV1"
        },
        {
            "$ref": "#/$defs/CoachInvocationV2"
        }
    ],
    "$defs": {
        "CoachInvocationV1": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                }
            },
            "required": [
                "invocationId",
                "attemptId",
                "providerIdempotencyValue",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationV2": {
            "type": "object",
            "properties": {
                "invocationId": {
                    "$ref": "#/$defs/CoachInvocationId"
                },
                "attemptId": {
                    "$ref": "#/$defs/CoachProviderAttemptId"
                },
                "providerIdempotencyValue": {
                    "$ref": "#/$defs/ProviderIdempotencyValue"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "expectedManifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "admittedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId"
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "invocationId",
                "attemptId",
                "providerIdempotencyValue",
                "libraryId",
                "chatId",
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "expectedManifestRevision",
                "admittedAt",
                "schemaVersion",
                "profileStatementGeneration"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachInvocationId": {
            "type": "string",
            "pattern": "^inv-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "CoachProviderAttemptId": {
            "type": "string",
            "pattern": "^atm-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ProviderIdempotencyValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._-]+$"
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatId": {
            "type": "string",
            "pattern": "^cht-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PendingUserTurnId": {
            "type": "string",
            "pattern": "^ptu-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "ProfileRevisionId": {
            "type": "string",
            "pattern": "^prf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        }
    }
}