{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/ChatMessage.json",
    "anyOf": [
        {
            "$ref": "#/$defs/PersistedUserChatMessageV1"
        },
        {
            "$ref": "#/$defs/PersistedCoachChatMessageV1"
        },
        {
            "$ref": "#/$defs/PersistedUserChatMessageV2"
        },
        {
            "$ref": "#/$defs/PersistedCoachChatMessageV2"
        }
    ],
    "$defs": {
        "PersistedUserChatMessageV1": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "messageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "role": {
                    "type": "string",
                    "const": "user"
                },
                "text": {
                    "type": "string",
                    "maxLength": 32768,
                    "description": "Legacy v1 used the 32,768-byte Draft ceiling; runtime preserves that reopen bound."
                }
            },
            "required": [
                "schemaVersion",
                "messageId",
                "responsePositionId",
                "createdAt",
                "role",
                "text"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PersistedCoachChatMessageV1": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "messageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "role": {
                    "type": "string",
                    "const": "coach"
                },
                "markdown": {
                    "type": "string",
                    "maxLength": 64000,
                    "description": "Persistence also rejects an exact encoded envelope above its 64 KiB root cap."
                }
            },
            "required": [
                "schemaVersion",
                "messageId",
                "responsePositionId",
                "createdAt",
                "role",
                "markdown"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PersistedUserChatMessageV2": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "messageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "role": {
                    "type": "string",
                    "const": "user"
                },
                "text": {
                    "type": "string",
                    "maxLength": 16384,
                    "description": "Application additionally enforces a 16,384 UTF-8-byte ceiling."
                }
            },
            "required": [
                "schemaVersion",
                "messageId",
                "responsePositionId",
                "createdAt",
                "role",
                "text"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PersistedCoachChatMessageV2": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "messageId": {
                    "$ref": "#/$defs/ChatMessageId"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "role": {
                    "type": "string",
                    "const": "coach"
                },
                "profileRevisionId": {
                    "$ref": "#/$defs/ProfileRevisionId",
                    "description": "Exact Profile authority used to prepare this Coach response."
                },
                "profileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "markdown": {
                    "type": "string",
                    "maxLength": 64000,
                    "description": "Persistence also rejects an exact encoded envelope above its 64 KiB root cap."
                }
            },
            "required": [
                "schemaVersion",
                "messageId",
                "responsePositionId",
                "createdAt",
                "role",
                "profileStatementGeneration",
                "markdown"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatMessageId": {
            "type": "string",
            "pattern": "^msg-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "ProfileRevisionId": {
            "type": "string",
            "pattern": "^prf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        }
    }
}