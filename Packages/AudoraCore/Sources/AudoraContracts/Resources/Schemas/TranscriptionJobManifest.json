{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/TranscriptionJobManifest.json",
    "anyOf": [
        {
            "$ref": "#/$defs/LegacyTranscriptionJobManifest"
        },
        {
            "$ref": "#/$defs/ControlledTranscriptionJobManifest"
        },
        {
            "$ref": "#/$defs/SequencedTranscriptionJobManifest"
        }
    ],
    "description": "Minimal durable state for one Session transcription job.",
    "$defs": {
        "LegacyTranscriptionJobManifest": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                }
            },
            "required": [
                "schemaVersion"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/TranscriptionJobManifestBody"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ControlledTranscriptionJobManifest": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "expectedSelectedRevisionId": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TranscriptRevisionId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "cancellationAuthorityId": {
                    "$ref": "#/$defs/TranscriptionCancellationAuthorityId"
                },
                "cancellationRequestedAt": {
                    "$ref": "#/$defs/UTCInstant"
                }
            },
            "required": [
                "schemaVersion",
                "expectedSelectedRevisionId",
                "cancellationAuthorityId"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/TranscriptionJobManifestBody"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SequencedTranscriptionJobManifest": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 3
                },
                "attemptSequence": {
                    "$ref": "#/$defs/SessionProcessingAttemptSequence"
                },
                "expectedSelectedRevisionId": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TranscriptRevisionId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "cancellationAuthorityId": {
                    "$ref": "#/$defs/TranscriptionCancellationAuthorityId"
                },
                "cancellationRequestedAt": {
                    "$ref": "#/$defs/UTCInstant"
                }
            },
            "required": [
                "schemaVersion",
                "attemptSequence",
                "expectedSelectedRevisionId",
                "cancellationAuthorityId"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/TranscriptionJobManifestBody"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "TranscriptionJobManifestBody": {
            "type": "object",
            "properties": {
                "jobId": {
                    "$ref": "#/$defs/TranscriptionJobId"
                },
                "sessionId": {
                    "$ref": "#/$defs/SessionId"
                },
                "revisionId": {
                    "$ref": "#/$defs/TranscriptRevisionId"
                },
                "profileId": {
                    "$ref": "#/$defs/TranscriptionProfileId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "state": {
                    "$ref": "#/$defs/TranscriptionJobState"
                },
                "candidateArtifactSha256": {
                    "$ref": "#/$defs/Sha256Hex"
                },
                "failure": {
                    "$ref": "#/$defs/SessionProcessingFailure"
                }
            },
            "required": [
                "jobId",
                "sessionId",
                "revisionId",
                "profileId",
                "createdAt",
                "state"
            ]
        },
        "TranscriptRevisionId": {
            "type": "string",
            "pattern": "^trv-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "TranscriptionCancellationAuthorityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z_-]+$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "SessionProcessingAttemptSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "TranscriptionJobId": {
            "type": "string",
            "pattern": "^job-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "TranscriptionProfileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9A-Za-z._-]+$"
        },
        "TranscriptionJobState": {
            "type": "string",
            "enum": [
                "queued",
                "preparing",
                "running",
                "validating",
                "completed",
                "failed",
                "cancelled",
                "interrupted"
            ]
        },
        "Sha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "SessionProcessingFailure": {
            "type": "string",
            "enum": [
                "sourceUnavailable",
                "jobPersistenceFailed",
                "engineUnavailable",
                "engineFailed",
                "candidateRejected",
                "publicationFailed",
                "installedNeedsRefresh",
                "canonicalRevisionIntegrityFailed",
                "staleSelection"
            ]
        }
    }
}