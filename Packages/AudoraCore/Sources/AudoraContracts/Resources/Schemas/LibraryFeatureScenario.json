{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/LibraryFeatureScenario.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "scenarioId": {
            "type": "string"
        },
        "initialState": {
            "$ref": "#/$defs/LibraryFeatureScenarioState"
        },
        "command": {
            "$ref": "#/$defs/LibraryFeatureScenarioCommand"
        },
        "commands": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/LibraryFeatureScenarioCommand"
            }
        },
        "dependencyTrace": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/LibraryFeatureDependencyEvent"
            }
        },
        "expectedState": {
            "$ref": "#/$defs/LibraryFeatureScenarioState"
        },
        "expectedEffects": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/LibraryFeatureEffect"
            }
        }
    },
    "required": [
        "schemaVersion",
        "scenarioId",
        "initialState",
        "dependencyTrace",
        "expectedState",
        "expectedEffects"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Portable Library lifecycle behavior shared by feature implementations.",
    "$defs": {
        "LibraryFeatureScenarioState": {
            "anyOf": [
                {
                    "$ref": "#/$defs/LibraryFeatureAwaitingBootstrapState"
                },
                {
                    "$ref": "#/$defs/LibraryFeatureNoLibrarySelectedState"
                },
                {
                    "$ref": "#/$defs/LibraryFeatureActiveState"
                },
                {
                    "$ref": "#/$defs/LibraryFeatureReadOnlyState"
                }
            ]
        },
        "LibraryFeatureScenarioCommand": {
            "type": "object",
            "properties": {
                "kind": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "start"
                        },
                        {
                            "type": "string",
                            "const": "create"
                        },
                        {
                            "type": "string",
                            "const": "chooseExisting"
                        },
                        {
                            "type": "string",
                            "const": "reopenRecent"
                        },
                        {
                            "type": "string",
                            "const": "openExternal"
                        },
                        {
                            "type": "string",
                            "const": "reveal"
                        },
                        {
                            "type": "string",
                            "const": "close"
                        }
                    ]
                },
                "token": {
                    "type": "string"
                }
            },
            "required": [
                "kind"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureDependencyEvent": {
            "type": "object",
            "properties": {
                "port": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "libraryWorkspace"
                        },
                        {
                            "type": "string",
                            "const": "clock"
                        },
                        {
                            "type": "string",
                            "const": "libraryIdGenerator"
                        }
                    ]
                },
                "effect": {
                    "type": "string"
                },
                "outcome": {
                    "type": "string"
                },
                "library": {
                    "$ref": "#/$defs/LibraryScenarioSnapshot"
                },
                "notice": {
                    "type": "string"
                }
            },
            "required": [
                "port",
                "effect",
                "outcome"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureEffect": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                }
            },
            "required": [
                "kind"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureAwaitingBootstrapState": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "awaitingBootstrap"
                }
            },
            "required": [
                "kind"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureNoLibrarySelectedState": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "noLibrarySelected"
                },
                "recentAvailable": {
                    "type": "boolean"
                },
                "notice": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "recentAvailable"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureActiveState": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "active"
                },
                "library": {
                    "$ref": "#/$defs/LibraryScenarioSnapshot"
                },
                "notice": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "library"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryFeatureReadOnlyState": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "readOnly"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "reason": {
                    "type": "string",
                    "const": "newerSchema"
                },
                "notice": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "reason"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryScenarioSnapshot": {
            "type": "object",
            "properties": {
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "preferences": {
                    "$ref": "#/$defs/LibraryScenarioPreferences"
                },
                "profileKind": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "null"
                        },
                        {
                            "type": "string",
                            "const": "selected"
                        }
                    ]
                },
                "statementCount": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "libraryId",
                "preferences",
                "profileKind",
                "statementCount"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "LibraryScenarioPreferences": {
            "type": "object",
            "properties": {
                "language": {
                    "type": "string",
                    "const": "en"
                },
                "annotationsVisible": {
                    "type": "boolean"
                },
                "playbackRate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "language",
                "annotationsVisible",
                "playbackRate"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        }
    }
}