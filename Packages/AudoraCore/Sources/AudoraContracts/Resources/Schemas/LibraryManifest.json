{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/LibraryManifest.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "formatName": {
            "type": "string",
            "const": "audora-library"
        },
        "libraryId": {
            "$ref": "#/$defs/LibraryId"
        },
        "createdAt": {
            "$ref": "#/$defs/UTCInstant"
        },
        "lastSuccessfulMigration": {
            "$ref": "#/$defs/PositiveWholeNumber"
        }
    },
    "required": [
        "schemaVersion",
        "formatName",
        "libraryId",
        "createdAt",
        "lastSuccessfulMigration"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "PositiveWholeNumber": {
            "type": "integer",
            "minimum": 1
        }
    }
}