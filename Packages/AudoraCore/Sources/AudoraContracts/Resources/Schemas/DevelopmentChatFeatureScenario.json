                },
                "query": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "query"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "OpenDevelopmentChatScenarioCommand": {
            "type": "object",
