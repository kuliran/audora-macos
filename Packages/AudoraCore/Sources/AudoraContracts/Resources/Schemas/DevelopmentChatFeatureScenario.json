                "kind": {
                    "type": "string",
                    "const": "createNewChatFromCapacityFailure"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                }
            },
            "required": [
                "kind",
                "pendingUserTurnId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DiscardPendingUserTurnScenarioCommand": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "discardPendingUserTurn"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                }
            },
            "required": [
                "kind",
