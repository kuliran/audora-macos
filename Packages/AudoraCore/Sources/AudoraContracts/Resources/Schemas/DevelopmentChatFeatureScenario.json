                    "$ref": "#/$defs/ChatId"
                }
            },
            "required": [
                "kind",
                "chatId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "EditDevelopmentChatDraftScenarioCommand": {
            "type": "object",
