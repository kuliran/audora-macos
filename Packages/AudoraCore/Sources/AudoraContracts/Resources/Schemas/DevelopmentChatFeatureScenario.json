{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/DevelopmentChatFeatureScenario.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "scenarioId": {
            "type": "string"
        },
        "libraryId": {
            "$ref": "#/$defs/LibraryId"
        },
        "initialChats": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/DevelopmentChatScenarioSnapshot"
            }
        },
        "commands": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/DevelopmentChatScenarioCommand"
            }
        },
        "dependencyTrace": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/DevelopmentChatDependencyEvent"
            }
        },
        "expectedState": {
            "$ref": "#/$defs/DevelopmentChatScenarioState"
        },
        "expectedProviderCalls": {
            "type": "number",
            "const": 0
        },
        "expectedInvocationCalls": {
            "type": "number",
            "const": 0
        },
        "expectedAdmissionCalls": {
            "type": "number",
            "const": 0
        },
        "providerAvailability": {
            "$ref": "#/$defs/DevelopmentChatScenarioProviderAvailability"
        },
        "contextCapacityMode": {
            "$ref": "#/$defs/DevelopmentChatScenarioContextCapacityMode"
        },
        "suspendedEffect": {
            "$ref": "#/$defs/DevelopmentChatScenarioSuspendedEffect"
        }
    },
    "required": [
        "schemaVersion",
        "scenarioId",
        "libraryId",
        "initialChats",
        "commands",
        "dependencyTrace",
        "expectedState",
        "expectedProviderCalls",
        "expectedInvocationCalls",
        "expectedAdmissionCalls"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Portable zero-Session Development Chat behavior shared by feature implementations.",
    "$defs": {
        "LibraryId": {
            "type": "string",
            "pattern": "^lib-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "DevelopmentChatScenarioSnapshot": {
            "type": "object",
            "properties": {
                "chatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "memoryId": {
                    "$ref": "#/$defs/CoachMemoryId"
                },
                "manifestRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "title": {
                    "$ref": "#/$defs/ChatTitleText"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "updatedAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "creationKind": {
                    "type": "string",
                    "const": "newChat"
                },
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ChatSessionAttachment"
                    },
                    "maxItems": 128
                },
                "draftText": {
                    "$ref": "#/$defs/ChatDraftText"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "messageIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ChatMessageId"
                    }
                },
                "memoryGeneralNotes": {
                    "type": "string"
                },
                "memorySessionSummaries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/PersistedCoachMemorySessionSummary"
                    }
                }
            },
            "required": [
                "chatId",
                "draftId",
                "memoryId",
                "manifestRevision",
                "title",
                "createdAt",
                "updatedAt",
                "creationKind",
                "attachments",
                "draftText",
                "draftVersion",
                "messageIds",
                "memoryGeneralNotes",
                "memorySessionSummaries"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DevelopmentChatScenarioCommand": {
            "oneOf": [
                {
                    "$ref": "#/$defs/CreateDevelopmentChatScenarioCommand"
                },
                {
                    "$ref": "#/$defs/RenameDevelopmentChatScenarioCommand"
                },
                {
                    "$ref": "#/$defs/SetDevelopmentChatFilterScenarioCommand"
                },
                {
                    "$ref": "#/$defs/OpenDevelopmentChatScenarioCommand"
                },
                {
                    "$ref": "#/$defs/EditDevelopmentChatDraftScenarioCommand"
                },
                {
                    "$ref": "#/$defs/RefreshDevelopmentChatContextQuoteScenarioCommand"
                },
                {
                    "$ref": "#/$defs/SendDevelopmentChatDraftScenarioCommand"
                },
                {
                    "$ref": "#/$defs/RetryPendingUserTurnScenarioCommand"
                },
                {
                    "$ref": "#/$defs/CreateNewChatFromCapacityFailureScenarioCommand"
                },
                {
                    "$ref": "#/$defs/DiscardPendingUserTurnScenarioCommand"
                },
                {
                    "$ref": "#/$defs/StartDevelopmentChatScenarioCommand"
                }
            ]
        },
        "DevelopmentChatDependencyEvent": {
            "oneOf": [
                {
                    "$ref": "#/$defs/ChatStoreCatalogLoadedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreCatalogFailedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreChatLoadedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreChatFrozenEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreChatCreatedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreCreateCollisionEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreChatRenamedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreRenameStaleEvent"
                },
                {
                    "$ref": "#/$defs/ChatStoreDraftSavedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStorePendingUserTurnLockedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStorePendingUserTurnReplacedEvent"
                },
                {
                    "$ref": "#/$defs/ChatStorePendingUserTurnDiscardedEvent"
                },
                {
                    "$ref": "#/$defs/ProfileStatementGenerationReadEvent"
                },
                {
                    "$ref": "#/$defs/CurrentInstantReadEvent"
                },
                {
                    "$ref": "#/$defs/ChatIdGeneratedEvent"
                },
                {
                    "$ref": "#/$defs/ChatDraftIdGeneratedEvent"
                },
                {
                    "$ref": "#/$defs/CoachMemoryIdGeneratedEvent"
                },
                {
                    "$ref": "#/$defs/PendingUserTurnIdGeneratedEvent"
                },
                {
                    "$ref": "#/$defs/ChatResponsePositionIdGeneratedEvent"
                }
            ]
        },
        "DevelopmentChatScenarioState": {
            "type": "object",
            "properties": {
                "allChatIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ChatId"
                    }
                },
                "visibleChatIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ChatId"
                    }
                },
                "catalogStatus": {
                    "$ref": "#/$defs/DevelopmentChatScenarioCatalogStatus"
                },
                "selectedChatId": {
                    "$ref": "#/$defs/ChatId"
                },
                "selectedTitle": {
                    "$ref": "#/$defs/ChatTitleText"
                },
                "selectedRevision": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "selectedAvailability": {
                    "$ref": "#/$defs/DevelopmentChatScenarioSelectionAvailability"
                },
                "selectedFrozenReason": {
                    "$ref": "#/$defs/DevelopmentChatScenarioFrozenReason"
                },
                "selectedDraftText": {
                    "$ref": "#/$defs/ChatDraftText"
                },
                "selectedDraftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "composerStatus": {
                    "$ref": "#/$defs/DevelopmentChatScenarioComposerStatus"
                },
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "pendingFailure": {
                    "$ref": "#/$defs/PendingUserTurnFailure"
                },
                "notice": {
                    "$ref": "#/$defs/DevelopmentChatScenarioNotice"
                }
            },
            "required": [
                "allChatIds",
                "visibleChatIds"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "DevelopmentChatScenarioProviderAvailability": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "available"
                },
                {
                    "type": "string",
                    "const": "unavailable"
                }
            ]
        },
        "DevelopmentChatScenarioContextCapacityMode": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "alwaysFits"
                },
                {
                    "type": "string",
                    "const": "cannotFitThenFits"
                }
            ]
        },
        "DevelopmentChatScenarioSuspendedEffect": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "firstCatalogLoad"
                }
            ]
        },
        "ChatId": {
            "type": "string",
            "pattern": "^cht-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "CoachMemoryId": {
            "type": "string",
            "pattern": "^mem-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatTitleText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "ChatSessionAttachment": {
            "type": "object",
            "properties": {
                "attachmentId": {
                    "$ref": "#/$defs/ChatSessionAttachmentId"
                },
                "sessionId": {
                    "$ref": "#/$defs/SessionId"
                },
                "transcriptRevisionId": {
                    "$ref": "#/$defs/TranscriptRevisionId"
                }
            },
            "required": [
                "attachmentId",
                "sessionId",
                "transcriptRevisionId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatDraftText": {
            "type": "string",
            "maxLength": 32768
        },
        "ChatMessageId": {
            "type": "string",
            "pattern": "^msg-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PersistedCoachMemorySessionSummary": {
            "type": "object",
            "properties": {
                "sessionAttachmentId": {
                    "$ref": "#/$defs/ChatSessionAttachmentId"
                },
                "notes": {
                    "type": "string",
                    "maxLength": 32768
                }
            },
            "required": [
                "sessionAttachmentId",
                "notes"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CreateDevelopmentChatScenarioCommand": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "createDevelopmentChat"
                }
            },
            "required": [
                "kind"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "RenameDevelopmentChatScenarioCommand": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "rename"
