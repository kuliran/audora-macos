                    "type": "string",
                    "const": "start"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                }
            },
            "required": [
                "kind",
                "libraryId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatStoreCatalogLoadedEvent": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "string",
                    "const": "chatStore"
                },
                "effect": {
                    "type": "string",
                    "const": "loadCatalog"
                },
                "outcome": {
                    "type": "string",
                    "const": "loaded"
                },
                "libraryId": {
                    "$ref": "#/$defs/LibraryId"
                },
                "chatIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ChatId"
                    }
                }
