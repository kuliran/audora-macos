{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/PendingUserTurn.json",
    "anyOf": [
        {
            "$ref": "#/$defs/PendingUserTurnV1"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV2"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV3"
        }
    ],
    "$defs": {
        "PendingUserTurnV1": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV1"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV2": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV2"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV3": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 3
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailure"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnId": {
            "type": "string",
            "pattern": "^ptu-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PendingUserTurnFailureV1": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                }
            ]
        },
        "PendingUserTurnFailureV2": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                },
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                }
            ]
        },
        "PendingUserTurnFailure": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                },
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                },
                {
                    "type": "string",
                    "const": "coachProviderError"
                },
                {
                    "type": "string",
                    "const": "coachResponseInvalid"
                }
            ]
        }
    }
}