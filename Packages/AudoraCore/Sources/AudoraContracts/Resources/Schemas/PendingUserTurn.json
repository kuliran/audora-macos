{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/PendingUserTurn.json",
    "anyOf": [
        {
            "$ref": "#/$defs/PendingUserTurnV1"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV2"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV3"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV4"
        },
        {
            "$ref": "#/$defs/PendingUserTurnTranscriptReadFailureV4"
        },
        {
            "$ref": "#/$defs/PendingUserTurnV5"
        },
        {
            "$ref": "#/$defs/PendingUserTurnTranscriptReadFailureV5"
        }
    ],
    "$defs": {
        "PendingUserTurnV1": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV1"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV2": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 2
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV2"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV3": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 3
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV3"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV4": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 4
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV3"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnTranscriptReadFailureV4": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 4
                },
                "failure": {
                    "type": "string",
                    "const": "coachTranscriptReadFailed"
                },
                "transcriptReadFailure": {
                    "$ref": "#/$defs/CoachTranscriptReadFailureSummary"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion",
                "failure",
                "transcriptReadFailure"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnV5": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 5
                },
                "failure": {
                    "$ref": "#/$defs/PendingUserTurnFailureV3"
                },
                "preparedProfileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnTranscriptReadFailureV5": {
            "type": "object",
            "properties": {
                "pendingUserTurnId": {
                    "$ref": "#/$defs/PendingUserTurnId"
                },
                "draftId": {
                    "$ref": "#/$defs/ChatDraftId"
                },
                "draftVersion": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                },
                "responsePositionId": {
                    "$ref": "#/$defs/ChatResponsePositionId"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 5
                },
                "failure": {
                    "type": "string",
                    "const": "coachTranscriptReadFailed"
                },
                "transcriptReadFailure": {
                    "$ref": "#/$defs/CoachTranscriptReadFailureSummary"
                },
                "preparedProfileStatementGeneration": {
                    "$ref": "#/$defs/NonnegativeWholeNumber"
                }
            },
            "required": [
                "pendingUserTurnId",
                "draftId",
                "draftVersion",
                "responsePositionId",
                "schemaVersion",
                "failure",
                "transcriptReadFailure"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PendingUserTurnId": {
            "type": "string",
            "pattern": "^ptu-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "ChatDraftId": {
            "type": "string",
            "pattern": "^drf-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "NonnegativeWholeNumber": {
            "type": "integer",
            "minimum": 0
        },
        "ChatResponsePositionId": {
            "type": "string",
            "pattern": "^rsp-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "PendingUserTurnFailureV1": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                }
            ]
        },
        "PendingUserTurnFailureV2": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                },
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                }
            ]
        },
        "PendingUserTurnFailureV3": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "coachContextCannotFit"
                },
                {
                    "type": "string",
                    "const": "coachResponseInterrupted"
                },
                {
                    "type": "string",
                    "const": "coachProviderError"
                },
                {
                    "type": "string",
                    "const": "coachResponseInvalid"
                }
            ]
        },
        "CoachTranscriptReadFailureSummary": {
            "anyOf": [
                {
                    "$ref": "#/$defs/CompleteCoachTranscriptReadFailureSummary"
                },
                {
                    "$ref": "#/$defs/TruncatedCoachTranscriptReadFailureSummary"
                }
            ]
        },
        "CompleteCoachTranscriptReadFailureSummary": {
            "type": "object",
            "properties": {
                "sessions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachTranscriptReadFailureSession"
                    },
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true
                },
                "additionalSessionCount": {
                    "type": "number",
                    "const": 0
                }
            },
            "required": [
                "sessions",
                "additionalSessionCount"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "TruncatedCoachTranscriptReadFailureSummary": {
            "type": "object",
            "properties": {
                "sessions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CoachTranscriptReadFailureSession"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true
                },
                "additionalSessionCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 125
                }
            },
            "required": [
                "sessions",
                "additionalSessionCount"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CoachTranscriptReadFailureSession": {
            "type": "object",
            "properties": {
                "sessionAttachmentId": {
                    "$ref": "#/$defs/ChatSessionAttachmentId"
                },
                "displayLabel": {
                    "$ref": "#/$defs/CoachTranscriptReadFailureDisplayLabel"
                }
            },
            "required": [
                "sessionAttachmentId",
                "displayLabel"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ChatSessionAttachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z_-]+$"
        },
        "CoachTranscriptReadFailureDisplayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        }
    }
}