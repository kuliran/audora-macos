{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/SessionProcessingAttemptIndex.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "sessions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SessionProcessingSessionAttempts"
            },
            "maxItems": 10000
        }
    },
    "required": [
        "schemaVersion",
        "sessions"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Authoritative per-Session attempt order and exact current-Job pointer.",
    "$defs": {
        "SessionProcessingSessionAttempts": {
            "type": "object",
            "properties": {
                "sessionId": {
                    "$ref": "#/$defs/SessionId"
                },
                "legacyJobIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TranscriptionJobId"
                    },
                    "maxItems": 10000
                },
                "attempts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionProcessingAttemptPointer"
                    },
                    "maxItems": 10000
                },
                "currentJobId": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TranscriptionJobId"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "pendingAttempt": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/SessionProcessingAttemptPointer"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "sessionId",
                "legacyJobIds",
                "attempts",
                "currentJobId",
                "pendingAttempt"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "TranscriptionJobId": {
            "type": "string",
            "pattern": "^job-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "SessionProcessingAttemptPointer": {
            "type": "object",
            "properties": {
                "sequence": {
                    "$ref": "#/$defs/SessionProcessingAttemptSequence"
                },
                "jobId": {
                    "$ref": "#/$defs/TranscriptionJobId"
                }
            },
            "required": [
                "sequence",
                "jobId"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SessionProcessingAttemptSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        }
    }
}