{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/SessionManifest.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "sessionId": {
            "$ref": "#/$defs/SessionId"
        },
        "createdAt": {
            "$ref": "#/$defs/UTCInstant"
        },
        "durationMs": {
            "$ref": "#/$defs/CanonicalDurationMilliseconds"
        },
        "audioManifestSha256": {
            "$ref": "#/$defs/Sha256Hex"
        },
        "transcriptRevisionIds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "maxItems": 0
        }
    },
    "required": [
        "schemaVersion",
        "sessionId",
        "createdAt",
        "durationMs",
        "audioManifestSha256",
        "transcriptRevisionIds"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "CanonicalDurationMilliseconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2700000
        },
        "Sha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}