{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/SessionManifest.json",
    "anyOf": [
        {
            "$ref": "#/$defs/ImportedSessionManifest"
        },
        {
            "$ref": "#/$defs/RecordedSessionManifest"
        }
    ],
    "description": "Closed union of every persisted Session aggregate-manifest variant.",
    "$defs": {
        "ImportedSessionManifest": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "sessionId": {
                    "$ref": "#/$defs/SessionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "durationMs": {
                    "$ref": "#/$defs/CanonicalDurationMilliseconds"
                },
                "audioManifestSha256": {
                    "$ref": "#/$defs/Sha256Hex"
                },
                "transcriptRevisionIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TranscriptRevisionId"
                    },
                    "maxItems": 256
                },
                "selectedTranscriptRevision": {
                    "$ref": "#/$defs/SelectedTranscriptRevision"
                }
            },
            "required": [
                "schemaVersion",
                "sessionId",
                "createdAt",
                "durationMs",
                "audioManifestSha256",
                "transcriptRevisionIds"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Aggregate commit marker for an imported Session."
        },
        "RecordedSessionManifest": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "number",
                    "const": 1
                },
                "sessionId": {
                    "$ref": "#/$defs/SessionId"
                },
                "createdAt": {
                    "$ref": "#/$defs/UTCInstant"
                },
                "audioManifestPath": {
                    "type": "string",
                    "const": "audio/audio.json"
                },
                "transcriptRevisionIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TranscriptRevisionId"
                    },
                    "maxItems": 256
                },
                "selectedTranscriptRevision": {
                    "$ref": "#/$defs/SelectedTranscriptRevision"
                }
            },
            "required": [
                "schemaVersion",
                "sessionId",
                "createdAt",
                "audioManifestPath",
                "transcriptRevisionIds"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Aggregate commit marker for a microphone-recorded Session."
        },
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "CanonicalDurationMilliseconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2700000
        },
        "Sha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "TranscriptRevisionId": {
            "type": "string",
            "pattern": "^trv-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "SelectedTranscriptRevision": {
            "type": "object",
            "properties": {
                "revisionId": {
                    "$ref": "#/$defs/TranscriptRevisionId"
                },
                "revisionSha256": {
                    "$ref": "#/$defs/Sha256Hex"
                }
            },
            "required": [
                "revisionId",
                "revisionSha256"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    }
}