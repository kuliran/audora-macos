{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://audora.local/contracts/SessionManifest.json",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number",
            "const": 1
        },
        "sessionId": {
            "$ref": "#/$defs/SessionId"
        },
        "createdAt": {
            "$ref": "#/$defs/UTCInstant"
        },
        "audioManifestPath": {
            "type": "string",
            "const": "audio/audio.json"
        }
    },
    "required": [
        "schemaVersion",
        "sessionId",
        "createdAt",
        "audioManifestPath"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Session aggregate commit marker.",
    "$defs": {
        "SessionId": {
            "type": "string",
            "pattern": "^ses-[0-9]{8}T[0-9]{9}Z-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "UTCInstant": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
    }
}